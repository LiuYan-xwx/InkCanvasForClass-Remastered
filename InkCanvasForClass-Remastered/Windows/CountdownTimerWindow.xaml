<Window
    x:Class="InkCanvasForClass_Remastered.CountdownTimerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:processbars="clr-namespace:InkCanvasForClass_Remastered.ProcessBars"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:viewmodels="clr-namespace:InkCanvasForClass_Remastered.ViewModels"
    Title="InkCanvasForClass-Remastered 计时器"
    Width="1100"
    Height="700"
    d:DataContext="{d:DesignInstance Type=viewmodels:CountdownTimerViewModel}"
    ui:ThemeManager.RequestedTheme="Light"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <system:Int32 x:Key="PlusOne">1</system:Int32>
        <system:Int32 x:Key="PlusFive">5</system:Int32>
        <system:Int32 x:Key="MinusOne">-1</system:Int32>
        <system:Int32 x:Key="MinusFive">-5</system:Int32>
        <Style x:Key="CountdownButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FBFBFD" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ui:ControlHelper.CornerRadius" Value="100" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="3"
                        Direction="0"
                        Opacity="0.1"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding ui:ControlHelper.CornerRadius}">
                            <Grid>
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="Black"
                                    CornerRadius="{TemplateBinding ui:ControlHelper.CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CountdownAdjustButtonStyle"
            BasedOn="{StaticResource CountdownButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="12" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Setter Property="ui:ControlHelper.CornerRadius" Value="2" />
        </Style>
        <Style
            x:Key="CountdownTextButtonStyle"
            BasedOn="{StaticResource CountdownButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimeDigitsStyle" TargetType="ItemsControl">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5B5D5F" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            Width="14"
                            Text="{Binding}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTimeHighlighted}" Value="True">
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimeSeparatorStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="Foreground" Value="{Binding Foreground, ElementName=TextControlHour}" />
            <Setter Property="Text" Value=":" />
            <Setter Property="Margin" Value="0,-2.5,0,0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="WindowContent"
                        Storyboard.TargetProperty="Opacity"
                        From="0.5"
                        To="1"
                        Duration="0:0:0.25" />
                    <DoubleAnimation
                        Storyboard.TargetName="WindowContent"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="10"
                        To="0"
                        Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Border
        x:Name="WindowContent"
        Margin="60"
        Background="#F0F3F9"
        BorderBrush="#0066BF"
        BorderThickness="1"
        CornerRadius="10"
        MouseLeftButtonDown="WindowDragMove">
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>
        <Grid>
            <Button
                x:Name="CompactTimeButton"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="CompactButton_Click"
                Style="{StaticResource CountdownTextButtonStyle}"
                ToolTip="恢复完整计时器"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="TbCurrentTime"
                    FontSize="56"
                    FontWeight="Black"
                    Text="{Binding TimeText}" />
            </Button>
            <Border
                Width="64"
                Height="15"
                Margin="0,0,0,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="Gray"
                CornerRadius="8"
                Visibility="{Binding ElementName=CompactTimeButton, Path=Visibility}" />
            <Viewbox x:Name="BigViewController" Margin="20">
                <Grid Width="200" Height="180">
                    <processbars:CycleProcessBar
                        x:Name="ProcessBarTime"
                        Width="150"
                        VerticalAlignment="Top"
                        CurrentValue="{Binding Progress}"
                        IsPaused="{Binding IsPaused}"
                        Visibility="{Binding ShowCountdownControls, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid
                        Width="100"
                        Height="28.5"
                        Margin="0,0,0,36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="TimeDisplayButton"
                            Grid.ColumnSpan="5"
                            Command="{Binding ToggleTimeEditingCommand}"
                            Style="{StaticResource CountdownTextButtonStyle}"
                            ToolTip="设置时间">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl
                                    x:Name="TextControlHour"
                                    ItemsSource="{Binding HourText}"
                                    Style="{StaticResource TimeDigitsStyle}" />
                                <TextBlock Width="8" Style="{StaticResource TimeSeparatorStyle}" />
                                <ItemsControl
                                    x:Name="TextControlMinute"
                                    ItemsSource="{Binding MinuteText}"
                                    Style="{StaticResource TimeDigitsStyle}" />
                                <TextBlock Width="8" Style="{StaticResource TimeSeparatorStyle}" />
                                <ItemsControl
                                    x:Name="TextControlSecond"
                                    ItemsSource="{Binding SecondText}"
                                    Style="{StaticResource TimeDigitsStyle}" />
                            </StackPanel>
                        </Button>
                        <Grid
                            x:Name="GridAdjustHour"
                            Grid.Column="0"
                            Margin="0,-24,0,-32"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ikw:SimpleStackPanel VerticalAlignment="Top" Spacing="2">
                                <Button
                                    Content="+5"
                                    Command="{Binding AdjustHoursCommand}"
                                    CommandParameter="{StaticResource PlusFive}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="增加 5 小时" />
                                <Button
                                    Content="+1"
                                    Command="{Binding AdjustHoursCommand}"
                                    CommandParameter="{StaticResource PlusOne}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="增加 1 小时" />
                            </ikw:SimpleStackPanel>
                            <ikw:SimpleStackPanel VerticalAlignment="Bottom" Spacing="2">
                                <Button
                                    Content="-1"
                                    Command="{Binding AdjustHoursCommand}"
                                    CommandParameter="{StaticResource MinusOne}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="减少 1 小时" />
                                <Button
                                    Content="-5"
                                    Command="{Binding AdjustHoursCommand}"
                                    CommandParameter="{StaticResource MinusFive}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="减少 5 小时" />
                            </ikw:SimpleStackPanel>
                        </Grid>
                        <Grid
                            Grid.Column="2"
                            Margin="0,-24,0,-32"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ikw:SimpleStackPanel VerticalAlignment="Top" Spacing="2">
                                <Button
                                    Content="+5"
                                    Command="{Binding AdjustMinutesCommand}"
                                    CommandParameter="{StaticResource PlusFive}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="增加 5 分钟" />
                                <Button
                                    Content="+1"
                                    Command="{Binding AdjustMinutesCommand}"
                                    CommandParameter="{StaticResource PlusOne}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="增加 1 分钟" />
                            </ikw:SimpleStackPanel>
                            <ikw:SimpleStackPanel VerticalAlignment="Bottom" Spacing="2">
                                <Button
                                    Content="-1"
                                    Command="{Binding AdjustMinutesCommand}"
                                    CommandParameter="{StaticResource MinusOne}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="减少 1 分钟" />
                                <Button
                                    Content="-5"
                                    Command="{Binding AdjustMinutesCommand}"
                                    CommandParameter="{StaticResource MinusFive}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="减少 5 分钟" />
                            </ikw:SimpleStackPanel>
                            <Button
                                x:Name="BtnTimeSetOkay"
                                Width="20"
                                Height="20"
                                Margin="0,0,0,-35"
                                VerticalAlignment="Bottom"
                                Background="#0066BF"
                                Command="{Binding ToggleTimeEditingCommand}"
                                Style="{StaticResource CountdownButtonStyle}"
                                ToolTip="保存时间">
                                <Viewbox Margin="5.5">
                                    <ui:SymbolIcon Foreground="White" Symbol="Save" />
                                </Viewbox>
                            </Button>
                        </Grid>
                        <Grid
                            Grid.Column="4"
                            Margin="0,-24,0,-32"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ikw:SimpleStackPanel VerticalAlignment="Top" Spacing="2">
                                <Button
                                    Content="+5"
                                    Command="{Binding AdjustSecondsCommand}"
                                    CommandParameter="{StaticResource PlusFive}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="增加 5 秒" />
                                <Button
                                    Content="+1"
                                    Command="{Binding AdjustSecondsCommand}"
                                    CommandParameter="{StaticResource PlusOne}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="增加 1 秒" />
                            </ikw:SimpleStackPanel>
                            <ikw:SimpleStackPanel VerticalAlignment="Bottom" Spacing="2">
                                <Button
                                    Content="-1"
                                    Command="{Binding AdjustSecondsCommand}"
                                    CommandParameter="{StaticResource MinusOne}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="减少 1 秒" />
                                <Button
                                    Content="-5"
                                    Command="{Binding AdjustSecondsCommand}"
                                    CommandParameter="{StaticResource MinusFive}"
                                    Style="{StaticResource CountdownAdjustButtonStyle}"
                                    ToolTip="减少 5 秒" />
                            </ikw:SimpleStackPanel>
                        </Grid>
                    </Grid>
                    <Border
                        x:Name="BorderStopTime"
                        Height="18"
                        Margin="0,23,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#E8EAF0"
                        CornerRadius="9"
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ikw:SimpleStackPanel Margin="6,0" Orientation="Horizontal">
                            <Image
                                Width="10"
                                Height="10"
                                Margin="0,0,2,0"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Resources/Icons-Fluent/ic_fluent_clock_24_regular.png" />
                            <TextBlock
                                x:Name="TextBlockStopTime"
                                VerticalAlignment="Center"
                                FontSize="9"
                                Text="{Binding StopTimeText}" />
                        </ikw:SimpleStackPanel>
                    </Border>
                    <ikw:SimpleStackPanel
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{Binding ShowCountdownControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button
                            x:Name="BtnStart"
                            Width="20"
                            Height="20"
                            Background="#0066BF"
                            Command="{Binding StartPauseCommand}"
                            Style="{StaticResource CountdownButtonStyle}"
                            ToolTip="{Binding StartButtonHint}"
                            ToolTipService.ShowOnDisabled="True">
                            <Viewbox Margin="5">
                                <ui:SymbolIcon x:Name="SymbolIconStart" Foreground="White">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Play" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Symbol" Value="Pause" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Viewbox>
                        </Button>
                        <Button
                            x:Name="BtnReset"
                            Width="20"
                            Height="20"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource CountdownButtonStyle}"
                            ToolTip="重置">
                            <Viewbox Margin="5.5">
                                <ui:SymbolIcon Symbol="Refresh" />
                            </Viewbox>
                        </Button>
                    </ikw:SimpleStackPanel>
                </Grid>
            </Viewbox>
            <Viewbox
                Margin="20"
                HorizontalAlignment="Right"
                Visibility="{Binding ElementName=BigViewController, Path=Visibility}">
                <ikw:SimpleStackPanel Height="180" Orientation="Horizontal">
                    <Button
                        x:Name="BtnMinimal"
                        Width="20"
                        Height="20"
                        Margin="5"
                        VerticalAlignment="Bottom"
                        Click="CompactButton_Click"
                        Style="{StaticResource CountdownButtonStyle}"
                        ToolTip="切换为紧凑模式"
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Viewbox Margin="5.5">
                            <ui:SymbolIcon Symbol="HideBcc" />
                        </Viewbox>
                    </Button>
                    <Button
                        x:Name="BtnFullscreen"
                        Width="20"
                        Height="20"
                        Margin="5"
                        VerticalAlignment="Bottom"
                        Click="FullscreenButton_Click"
                        Style="{StaticResource CountdownButtonStyle}"
                        ToolTip="切换全屏">
                        <Viewbox Margin="5.5">
                            <ui:SymbolIcon x:Name="SymbolIconFullscreen">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="FullScreen" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Symbol" Value="BackToWindow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Viewbox>
                    </Button>
                    <Button
                        x:Name="BtnClose"
                        Width="20"
                        Height="20"
                        Margin="5"
                        VerticalAlignment="Bottom"
                        Background="#E32A34"
                        Click="CloseButton_Click"
                        Style="{StaticResource CountdownButtonStyle}"
                        ToolTip="关闭">
                        <Viewbox Margin="5.5">
                            <ui:SymbolIcon Foreground="White" Symbol="Clear" />
                        </Viewbox>
                    </Button>
                </ikw:SimpleStackPanel>
            </Viewbox>
        </Grid>
    </Border>
</Window>
