<UserControl
    x:Class="InkCanvasForClass_Remastered.Controls.FloatingBarButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InkCanvasForClass_Remastered.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="28"
    Height="34"
    d:DesignHeight="34"
    d:DesignWidth="28"
    Background="Transparent"
    Focusable="False"
    IsTabStop="False"
    ToolTip="{Binding Label, RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">
    <Button
        Name="PART_Button"
        AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}"
        Command="{Binding Command, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}"
        CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}"
        Cursor="Hand"
        Focusable="False"
        IsTabStop="False">
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    x:Name="content"
                                    Margin="0,1,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="content" Property="Opacity" Value="0.5" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#20000000" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#30000000" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>
        <StackPanel Orientation="Vertical">
            <Grid Width="28" Height="17">
                <Viewbox x:Name="PART_Path">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconSource, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Path Data="{Binding PathData, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}" Fill="{Binding IconBrush, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}" />
                </Viewbox>
                <Image
                    x:Name="PART_Image"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding IconSource, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}" />
            </Grid>
            <TextBlock
                x:Name="PART_Label"
                Margin="0,1,0,0"
                FontSize="8"
                Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}"
                Text="{Binding Label, RelativeSource={RelativeSource AncestorType={x:Type local:FloatingBarButton}}}"
                TextAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
